{
  "schemaVersion": 1,
  "id": "mcflare",
  "version": "${version}",
  "name": "MCflare",
  "description": "Transparent Minecraft transport over WebSocket-compatible tunnels, with zero-config active discovery.",
  "authors": ["Phloraxx"],
  "contributors": ["HttpRafa (original Modflared project)"],
  "contact": {
    "sources": "https://github.com/Phloraxx/mcflare",
    "issues": "https://github.com/Phloraxx/mcflare/issues"
  },
  "license": "MIT",
  "icon": "assets/mcflare/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.mcflare.client.McflareClient"],
    "voicechat": ["io.mcflare.client.voice.McflareVoicechatPlugin"]
  },
  "mixins": ["mcflare.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
