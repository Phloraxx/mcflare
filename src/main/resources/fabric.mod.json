{
  "schemaVersion": 1,
  "id": "mcflare",
  "version": "${version}",
  "name": "MCflare",
  "description": "Transparent Minecraft transport over standard WebSocket, for Cloudflare Orange or Tunnel ingress.",
  "authors": ["Phloraxx"],
  "contributors": ["HttpRafa (original Modflared project)"],
  "contact": {
    "sources": "https://github.com/Phloraxx/mcflare",
    "issues": "https://github.com/Phloraxx/mcflare/issues"
  },
  "license": "MIT",
  "icon": "assets/mcflare/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": ["io.mcflare.client.McflareClient"]
  },
  "mixins": [
    "mcflare.mixins.json",
    {"config": "mcflare.server.mixins.json", "environment": "server"}
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${adapter_java_version}"
  }
}
